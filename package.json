{
  "name": "softcurse-website",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev",
    "cms:migrate:local": "wrangler d1 migrations apply softcurse-cms --local",
    "cms:migrate": "wrangler d1 migrations apply softcurse-cms --remote",
    "deploy": "npm run build && wrangler pages deploy --branch main",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^16.4.0",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  }
}
